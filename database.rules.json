{
  "rules": {
    "trips": {
      "$shareId": {
        ".read": true,
        ".write": true
      }
    },
    "appState": {
      ".read": true,
      ".write": true
    },
    "appConfig": {
      ".read": true,
      ".write": false,
      "googleMapsApiKey": {
        ".validate": "newData.isString() && newData.val().length < 200"
      }
    }
  }
}
